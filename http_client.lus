-- Module functions ------------------------------------------------------------

local shared

--- Sends a request with a client that has the default options.
---
--- The options and the results are those of the `request` method of a
--- client. `url` must be absolute.
--- @param method string The method.
--- @param url string The URL.
--- @param options table? The options.
--- @return table The response.
function M.request(method, url, options)
    shared = shared or M.new()
    return shared:request(method, url, options)
end

--- Sends a `GET` request with the default options. See `http_client.request`.
--- @param url string The URL.
--- @param options table? The options.
--- @return table The response.
function M.get(url, options)
    return M.request("GET", url, options)
end

--- Sends a `POST` request with the default options. See `http_client.request`.
--- @param url string The URL.
--- @param options table? The options.
--- @return table The response.
function M.post(url, options)
    return M.request("POST", url, options)
end

return M
